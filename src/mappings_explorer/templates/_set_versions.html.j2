{% block set_version %}
<section id="version-select" class="version-select">
  <meta
    id="version-config"
    data-versions='{{ valid_versions|tojson }}'
    data-project-id="{{ project.id if project is defined else '' }}"
    data-target-id="{{ project.target_id if project is defined else 'attack' }}"
  >

  <div class="container">
    <div class="row justify-content-left">
      <form class="col-12" onsubmit="handleSubmission(event)">
        <h2>SELECT VERSIONS</h2>
        <div class="row col-12" style="display: flex;">
          {% if versions %}
          <div class="col-sm-4 col-md-3 form-group">
            <p>{{ control }} Version</p>
            <div class="custom-select" id="control_version">
              <select name="control-version" id="control_version_select">
                <option value="0">Select version:</option>
                {% for v in versions %}
                <option>{{ v }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          {% endif %}

          <div class="col-sm-4 col-md-3 form-group">
            <p>{{ target_version_label }}</p>
            <div class="custom-select" id="target_version">
              <select name="target-version" id="target_version_select">
                <option value="0">Select version:</option>
                {% for v in targetVersions %}
                <option>{{ v }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="col-sm-4 col-md-3 form-group">
            <p>{{ target_domain_label }}</p>
            <div class="custom-select" id="target_domain">
              <select name="domain" id="target_domain_select">
                <option value="0">Select version:</option>
                {% for d in domains %}
                <option>{{ d }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="col-sm-4 col-md-3 form-group" style="margin-top: 28px;">
            <button class="btn-pill" style="border: none;">See Mappings</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
const versionConfig = document.getElementById("version-config");
const valid_versions = JSON.parse(versionConfig.dataset.versions || "[]");
const projectId = versionConfig.dataset.projectId || "";
const targetId = versionConfig.dataset.targetId || "attack";

var x, i, j, l, ll, selElmnt, a, b, c;

x = document.getElementsByClassName("custom-select");
l = x.length;

for (i = 0; i < l; i++) {
  selElmnt = x[i].getElementsByTagName("select")[0];
  ll = selElmnt.length;

  a = document.createElement("DIV");
  a.setAttribute("class", "select-selected");
  a.innerHTML = selElmnt.options[selElmnt.selectedIndex].innerHTML;
  x[i].appendChild(a);

  b = document.createElement("DIV");
  b.setAttribute("class", "select-items select-hide");

  for (j = 1; j < ll; j++) {
    c = document.createElement("DIV");
    c.innerHTML = selElmnt.options[j].innerHTML;
    c.addEventListener("click", function(e) {
      let control_version_el = document.getElementById("control_version_select");
      let target_version_el = document.getElementById("target_version_select");
      let target_domain_el = document.getElementById("target_domain_select");

      let control_version = control_version_el ? control_version_el.value : "";
      let target_version = target_version_el ? target_version_el.value : "";
      let target_domain = target_domain_el ? target_domain_el.value : "";

      const parentId = e.srcElement.parentNode.parentNode.id;

      if (parentId === "control_version") {
        control_version = e.srcElement.innerHTML;
      } else if (parentId === "target_version") {
        target_version = e.srcElement.innerHTML;
      } else if (parentId === "target_domain") {
        target_domain = e.srcElement.innerHTML;
      }

      let targetOptions = [];
      let versionOptions = [];
      let domainOptions = [];

      if (parentId === "target_version") {
        versionOptions = parseValidOptions(e.srcElement.innerHTML, "control_version", valid_versions);
        domainOptions = parseValidOptions(e.srcElement.innerHTML, "target_domain", valid_versions);
        setStates([
          { selectId: "control_version", options: versionOptions, currentValue: control_version },
          { selectId: "target_domain", options: domainOptions, currentValue: target_domain }
        ]);
      } else if (parentId === "control_version") {
        targetOptions = parseValidOptions(e.srcElement.innerHTML, "target_version", valid_versions);
        domainOptions = parseValidOptions(e.srcElement.innerHTML, "target_domain", valid_versions);
        setStates([
          { selectId: "target_version", options: targetOptions, currentValue: target_version },
          { selectId: "target_domain", options: domainOptions, currentValue: target_domain }
        ]);
      } else {
        versionOptions = parseValidOptions(e.srcElement.innerHTML, "control_version", valid_versions);
        targetOptions = parseValidOptions(e.srcElement.innerHTML, "target_version", valid_versions);
        setStates([
          { selectId: "control_version", options: versionOptions, currentValue: control_version },
          { selectId: "target_version", options: targetOptions, currentValue: target_version }
        ]);
      }

      var y, i, k, s, h, sl, yl;
      s = this.parentNode.parentNode.getElementsByTagName("select")[0];
      sl = s.length;
      h = this.parentNode.previousSibling;
      for (i = 0; i < sl; i++) {
        if (s.options[i].innerHTML == this.innerHTML) {
          s.selectedIndex = i;
          h.innerHTML = this.innerHTML;
          y = this.parentNode.getElementsByClassName("same-as-selected");
          yl = y.length;
          for (k = 0; k < yl; k++) {
            y[k].removeAttribute("class");
          }
          this.setAttribute("class", "same-as-selected");
          break;
        }
      }
      h.click();
    });
    b.appendChild(c);
  }

  x[i].appendChild(b);
  a.addEventListener("click", function(e) {
    e.stopPropagation();
    closeAllSelect(this);
    this.nextSibling.classList.toggle("select-hide");
    this.classList.toggle("select-arrow-active");
  });
}

function closeAllSelect(elmnt) {
  var x, y, i, xl, yl, arrNo = [];
  x = document.getElementsByClassName("select-items");
  y = document.getElementsByClassName("select-selected");
  xl = x.length;
  yl = y.length;
  for (i = 0; i < yl; i++) {
    if (elmnt == y[i]) {
      arrNo.push(i);
    } else {
      y[i].classList.remove("select-arrow-active");
    }
  }
  for (i = 0; i < xl; i++) {
    if (arrNo.indexOf(i)) {
      x[i].classList.add("select-hide");
    }
  }
}

document.addEventListener("click", closeAllSelect);

function setStates(valuesToValidate) {
  valuesToValidate.forEach(value => {
    const selectElement = document.getElementById(value.selectId);
    if (!selectElement) return;

    const itemsContainer = selectElement.getElementsByClassName("select-items")[0];
    if (!itemsContainer) return;

    const selectElementOptions = itemsContainer.children;
    for (let i = 0; i < selectElementOptions.length; i++) {
      if (value.options.includes(selectElementOptions[i].innerHTML)) {
        selectElementOptions[i].setAttribute("class", "valid-option");
      } else {
        selectElementOptions[i].setAttribute("class", "invalid-option");
      }
    }

    if (value.currentValue && !value.options.includes(value.currentValue)) {
      const firstValid = selectElement.getElementsByClassName("valid-option")[0];
      if (firstValid) {
        firstValid.click();
      }
    }
  });
}

function parseValidOptions(originalValue, returnValue, valid_versions) {
  let targetOptions = [];
  let versionOptions = [];
  let domainOptions = [];

  for (let i = 0; i < valid_versions.length; i++) {
    let row = valid_versions[i];
    for (let ii = 0; ii < row.length; ii++) {
      let element = row[ii];
      if (element == originalValue) {
        versionOptions.push(row[0]);
        targetOptions.push(row[1]);
        domainOptions.push(row[2]);
      }
    }
  }

  if (returnValue == "target_version") {
    return targetOptions;
  } else if (returnValue == "control_version") {
    return versionOptions;
  } else {
    return domainOptions;
  }
}

function setValue(id, value) {
  const d = document.getElementById(id);
  if (!d) return;

  const itemsContainer = d.getElementsByClassName("select-items")[0];
  if (!itemsContainer) return;

  const options = itemsContainer.children;
  if (!value) {
    if (options[0]) {
      options[0].click();
    }
    return;
  }

  for (let i = 0; i < options.length; i++) {
    if (options[i].innerHTML.toLowerCase() == value.toLowerCase()) {
      options[i].click();
      return;
    }
  }
}

function parseParams() {
  let targetVersion = "";
  let controlVersion = "";
  let targetDomain = "";
  let uri = window.location.pathname;
  let params = uri.split("/").filter(n => n);

  if (params.length > 4) {
    const controlSegment = params[params.length - 1];
    const domainSegment = params[params.length - 2];
    const targetSegment = params[params.length - 3];

    if (projectId && controlSegment.startsWith(projectId + "-")) {
      controlVersion = controlSegment.slice((projectId + "-").length);
    } else {
      controlVersion = controlSegment.split("-").slice(1).join("-");
    }

    if (domainSegment.startsWith("domain-")) {
      targetDomain = domainSegment.slice("domain-".length);
    } else {
      targetDomain = domainSegment;
    }

    if (targetId && targetSegment.startsWith(targetId + "-")) {
      targetVersion = targetSegment.slice((targetId + "-").length);
    } else {
      targetVersion = targetSegment.split("-").slice(1).join("-");
    }

    if (controlVersion) {
      setValue("control_version", controlVersion);
    }
    if (targetDomain) {
      setValue("target_domain", targetDomain);
    }
    if (targetVersion) {
      setValue("target_version", targetVersion);
    }
  } else {
    setValue("target_version", "");
  }
}

function handleSubmission(event) {
  event.preventDefault();

  let uri = window.location.pathname;
  let params = uri.split("/").filter(n => n);

  let controlEl = document.getElementById("control_version_select");
  let targetEl = document.getElementById("target_version_select");
  let domainEl = document.getElementById("target_domain_select");

  let newControl = controlEl ? controlEl.value : "";
  let newTarget = targetEl ? targetEl.value : "";
  let newDomain = domainEl ? domainEl.value.toLowerCase() : "";

  if (params.length > 4) {
    params[params.length - 1] = params[params.length - 4] + "-" + newControl;
    params[params.length - 2] = "domain-" + newDomain;
    params[params.length - 3] = targetId + "-" + newTarget;
  } else {
    params.push(targetId + "-" + newTarget);
    params.push("domain-" + newDomain);
    params.push(params[params.length - 3] + "-" + newControl);
  }

  let newUrl = params.join("/");
  window.location = "/" + newUrl + "/";
}

window.onload = parseParams;
</script>

{% endblock set_version %}
