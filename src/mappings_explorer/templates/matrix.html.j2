{% extends "base.html.j2" %}

{% block content %}
<div id="matrix-component">
  <Matrix
    :url_prefix="'{{ url_prefix }}'"
    :all_attack_versions='{{ all_attack_versions|tojson }}'
    :all_attack_domains='{{ attack_domains|tojson }}'
    :matrix_order='{{ matrix_order|tojson }}'
    :attack_domain_versions_with_mappings='{{ attack_domain_versions_with_mappings|tojson }}'
  ></Matrix>
</div>

<script>
  const Matrix = {
    template: `
      <section id="header-container" class="header-container">
        <div class="container">
          {% include "_breadcrumbs.html.j2" %}
          <div class="row justify-content-left">
            <div class="col-lg-8 col-md-10 col-sm-12">
              <h1><span class="highlight">ATT&CK</span> MATRIX</h1>
              <p>[[ description ]]</p>
              <p>
                View information about techniques, how techniques and tactics interact, and the
                <a href="https://ctid.mitre.org/" target="_blank">
                  Center for Threat-Informed Defense
                </a>'s mappings coverage of
                <a href="https://attack.mitre.org/" target="_blank">MITRE ATT&CK®</a>
                techniques in the Mappings Explorer matrix view below.
              </p>
            </div>

            <div
              class="download-artifacts col-lg-4 col-md-2 col-sm-12 ml-20"
              v-if="canDownloadArtifacts"
            >
              <h6>Download Mapping Artifacts:</h6>
              <div class="downloads">
                <p>
                  <a
                    class="link"
                    @click="downloadJson(
                      url_prefix + 'static/matrices/' + selectedDomain + '/' + selectedAttackVersion + '/' + selectedDomain + '-' + selectedAttackVersion + '_navigator_layer.json',
                      selectedDomain + '-' + selectedAttackVersion + '_navigator_layer.json'
                    )"
                  >
                    <span>
                      <img src="{{ url_prefix }}static/img/download.svg" alt="download" style="height: 20px;"/>
                    </span>
                    Navigator Layers
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="matrix-component" id="matrix">
        <div class="container">
          <div class="row justify-content-left">
            <form class="col-12 version-select">
              <h2>CHOOSE YOUR VERSIONS</h2>
              <div class="row col-12" style="display: flex;">
                <div class="col-md-2 col-sm-4 form-group" @focusout="handleOutsideClick" tabindex="-1">
                  <p>ATT&CK Version</p>
                  <div class="form-control select" @click="attackSelectOpen = !attackSelectOpen">
                    <span class="selected-item">[[ selectedAttackVersion ]]</span>
                  </div>
                  <div v-if="attackSelectOpen" class="dropdown-items">
                    <div
                      v-for="attackVersion in attackVersions"
                      :key="attackVersion"
                      :class="{
                        'dropdown-item': true,
                        'invalid-option': !isVersionValidForDomain(attackVersion, selectedDomain),
                        'selected-option': selectedAttackVersion === attackVersion
                      }"
                      @click="setSelectedAttackVersion(attackVersion); attackSelectOpen = false;"
                    >
                      <span class="dropdown-item-text">[[ attackVersion ]]</span>
                    </div>
                  </div>
                </div>

                <div class="col-md-2 col-sm-4 form-group" @focusout="handleOutsideClick" tabindex="-1">
                  <p>ATT&CK Domain</p>
                  <div class="form-control select" @click="domainSelectOpen = !domainSelectOpen">
                    <span class="selected-item">[[ formatDomainLabel(selectedDomain) ]]</span>
                  </div>
                  <div v-if="domainSelectOpen" class="dropdown-items">
                    <div
                      v-for="domain in attackDomains"
                      :key="domain"
                      :class="{
                        'dropdown-item': true,
                        'invalid-option': !isVersionValidForDomain(selectedAttackVersion, domain),
                        'selected-option': selectedDomain === domain
                      }"
                      @click="setSelectedDomain(domain); domainSelectOpen = false;"
                    >
                      <span class="dropdown-item-text">[[ formatDomainLabel(domain) ]]</span>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        <section id="matrix-table">
          <div class="container">
            <div class="row justify-content-left">
              <div class="col-12">
                <h2>ATT&CK v[[ selectedAttackVersion ]] [[ selectedDomain.toUpperCase() ]] MAPPINGS MATRIX</h2>

                <div v-if="errorMessage" class="alert alert-warning mt-3" role="alert">
                  [[ errorMessage ]]
                </div>

                <div class="matrix-table-container" v-if="!errorMessage">
                  <div class="row">
                    <div class="col-md-12" style="display: flex">
                      <button type="button" @click="toggleAllTechniques(true)" class="toggle-subtechniques-btn">
                        Show All Sub-Techniques
                      </button>
                      <button type="button" @click="toggleAllTechniques(false)" class="toggle-subtechniques-btn">
                        Hide All Sub-Techniques
                      </button>
                    </div>
                  </div>

                  <div class="matrix-table-container-relative">
                    <div class="scroll-indicator-left" v-if="!scrolledCompletelyToLeft"></div>

                    <div class="overflow-scroll" id="matrix-table-scrollable" @scroll="handleScroll">
                      <div class="row tactic-row row--no-x-margin row--no-padding flex-nowrap">
                        <div
                          v-for="tactic in tactics"
                          :key="tactic.id"
                          class="col-lg-1 col-md-2 col-sm-4 col--less-x-padding tactic-box"
                        >
                          <div class="tactic-header">
                            <a
                              :href="url_prefix + 'attack/attack-' + selectedAttackVersion + '/domain-' + selectedDomain + '/tactics/' + tactic.id + '/'"
                              class="tactic-name"
                            >
                              [[ tactic.name ]]
                            </a>
                            <br/>
                            ([[ tactic.id ]])
                          </div>
                        </div>
                      </div>

                      <div class="row row--no-x-margin row--no-padding flex-nowrap">
                        <div
                          class="col-lg-1 col-md-2 col-sm-4 col--less-x-padding"
                          v-for="tactic in tactics"
                          :key="'col-' + tactic.id"
                        >
                          <div
                            class="row row--no-x-margin row--no-padding"
                            v-for="technique in tactic.techniques"
                            :key="technique.id + '-' + tactic.id"
                          >
                            <div class="row row--no-x-margin row--no-padding">
                              <div
                                :class="{
                                  'col-2 align-items-center col--less-x-padding d-flex': true,
                                  'subtechnique-toggle-col': technique.subtechniques.length,
                                  'subtechnique-toggle-col--no-icon': !technique.subtechniques.length
                                }"
                              >
                                <img
                                  v-if="technique.subtechniques.length && !technique.open"
                                  @click="handleClick(technique)"
                                  class="icon"
                                  src="{{ url_prefix }}static/img/chevron-right.svg"
                                  alt=""
                                />
                                <img
                                  v-else-if="technique.subtechniques.length && technique.open"
                                  @click="handleClick(technique)"
                                  class="icon"
                                  src="{{ url_prefix }}static/img/chevron-down.svg"
                                  alt=""
                                />
                              </div>

                              <div
                                class="col-10 col--no-x-padding"
                                @mouseenter="techniqueHovered = technique"
                                @mouseleave="techniqueHovered = ''"
                                :id="technique.id + '_' + technique.parent + '_box'"
                              >
                                <div
                                  class="technique-box"
                                  :style="technique.background_color ? { backgroundColor: technique.background_color } : {}"
                                >
                                  <a
                                    v-if="technique.score > 0"
                                    :href="url_prefix + 'attack/attack-' + selectedAttackVersion + '/domain-' + selectedDomain + '/techniques/' + technique.id"
                                    @mouseenter="techniqueHovered = technique"
                                  >
                                    [[ technique.name ]]
                                  </a>
                                  <span v-else>[[ technique.name ]]</span>
                                  <br/>
                                  ([[ technique.id ]])
                                  <span class="technique-score" v-if="technique.subtechniques.length">
                                    ([[ technique.subtechniques.length ]])
                                  </span>
                                </div>
                              </div>
                            </div>

                            <div class="row row--no-x-margin row--no-padding">
                              <div class="col-2 col--no-x-padding subtechniques-col">
                                <svg
                                  fill="grey"
                                  v-if="technique.open && technique.subtechniques.length"
                                  width="12px"
                                  height="20px"
                                >
                                  <path d="M0 0H12V12Z"/>
                                </svg>
                              </div>

                              <div class="col-10 col--no-x-padding">
                                <div
                                  v-if="technique.open"
                                  v-for="subtechnique in technique.subtechniques"
                                  :key="subtechnique.id + '-' + subtechnique.parent"
                                  @mouseenter="techniqueHovered = subtechnique"
                                  @mouseleave="techniqueHovered = ''"
                                  :id="subtechnique.id + '_' + subtechnique.parent + '_box'"
                                >
                                  <div
                                    class="subtechnique-box"
                                    :style="subtechnique.background_color ? { backgroundColor: subtechnique.background_color } : {}"
                                  >
                                    <a
                                      v-if="subtechnique.score > 0"
                                      :href="url_prefix + 'attack/attack-' + selectedAttackVersion + '/domain-' + selectedDomain + '/techniques/' + subtechnique.id"
                                      @mouseenter="techniqueHovered = subtechnique"
                                    >
                                      [[ subtechnique.name ]]
                                    </a>
                                    <span v-else>[[ subtechnique.name ]]</span>
                                    <br/>
                                    ([[ subtechnique.id ]])
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="scroll-indicator-right" v-if="!scrolledCompletelyToRight"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div
          v-if="techniqueHovered && techniqueHovered.score > 0"
          class="technique-tooltip align-self-center align-content-start"
          :style="getTooltipPosition()"
        >
          <span><b>[[ techniqueHovered.id ]]</b></span>
          [[ " " + techniqueHovered.name ]]
          <hr class="header-row"/>
          <span>Mapped To:</span>
          <br/>
          <ul class="mapped-capability-list">
            <li v-for="mappedCapability in techniqueHovered.mapped_capabilities" :key="mappedCapability">
              [[ mappedCapability ]]
            </li>
          </ul>
        </div>
      </div>
    `,
    delimiters: ["[[", "]]"],
    props: {
      url_prefix: String,
      matrix_order: Object,
      all_attack_versions: Array,
      all_attack_domains: Object,
      attack_domain_versions_with_mappings: Object,
    },
    data() {
      return {
        amountMatrixColsShown: undefined,
        tactics: [],
        selectedTechnique: {},
        selectedAttackVersion: "16.1",
        attackObjectDict: {},
        techniqueHovered: "",
        selectedDomain: "enterprise",
        scrolledCompletelyToRight: false,
        scrolledCompletelyToLeft: true,
        attackSelectOpen: false,
        domainSelectOpen: false,
        description: "",
        matrixOrder: [],
        errorMessage: "",
      };
    },
    computed: {
      attackDomains() {
        return Object.keys(this.all_attack_domains || {});
      },
      attackVersions() {
        return this.all_attack_versions || [];
      },
      canDownloadArtifacts() {
        return (this.attack_domain_versions_with_mappings?.[this.selectedDomain] || []).includes(this.selectedAttackVersion);
      },
    },
    methods: {
      formatDomainLabel(domain) {
        if (!domain) return "";
        return domain.charAt(0).toUpperCase() + domain.slice(1);
      },

      isVersionValidForDomain(version, domain) {
        return (this.attack_domain_versions_with_mappings?.[domain] || []).includes(version);
      },

      syncUrl() {
        const newurl =
          `${window.location.origin}${window.location.pathname}` +
          `?attack-version=${this.selectedAttackVersion}&domain=${this.selectedDomain}`;
        window.history.pushState({ path: newurl }, "", newurl);
      },

      normalizeSelection() {
        const domains = this.attackDomains;
        if (!domains.length) {
          this.selectedDomain = "";
          return;
        }

        if (!domains.includes(this.selectedDomain)) {
          this.selectedDomain = domains[0];
        }

        const validVersionsForDomain =
          this.attack_domain_versions_with_mappings?.[this.selectedDomain] ||
          this.all_attack_domains?.[this.selectedDomain] ||
          [];

        if (!validVersionsForDomain.length) {
          this.selectedAttackVersion = this.attackVersions[0] || "";
          return;
        }

        if (!validVersionsForDomain.includes(this.selectedAttackVersion)) {
          this.selectedAttackVersion = validVersionsForDomain[0];
        }
      },

      setSelectedAttackVersion(version) {
        this.selectedAttackVersion = version;

        if (!this.isVersionValidForDomain(version, this.selectedDomain)) {
          const fallbackDomain = this.attackDomains.find((domain) =>
            this.isVersionValidForDomain(version, domain)
          );
          if (fallbackDomain) {
            this.selectedDomain = fallbackDomain;
          }
        }

        this.normalizeSelection();
        this.syncUrl();
        this.getAttackObjectDict();
      },

      setSelectedDomain(domain) {
        this.selectedDomain = String(domain || "").toLowerCase();

        if (!this.isVersionValidForDomain(this.selectedAttackVersion, this.selectedDomain)) {
          const validVersions =
            this.attack_domain_versions_with_mappings?.[this.selectedDomain] ||
            this.all_attack_domains?.[this.selectedDomain] ||
            [];
          if (validVersions.length) {
            this.selectedAttackVersion = validVersions[0];
          }
        }

        this.normalizeSelection();
        this.syncUrl();
        this.getAttackObjectDict();
      },

      downloadJson(file, filename) {
        fetch(file)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Failed to download file: " + response.status);
            }
            return response.json();
          })
          .then((json) => {
            const blob = new Blob([JSON.stringify(json)], {
              type: "application/json",
            });
            const link = document.createElement("a");
            link.href = window.URL.createObjectURL(blob);
            link.download = filename;
            link.click();
          })
          .catch((error) => {
            console.error(error);
            this.errorMessage = "Unable to download the navigator layer for this ATT&CK version/domain.";
          });
      },

      handleScroll(e) {
        const { offsetWidth, scrollWidth, scrollLeft } = e.target;
        this.scrolledCompletelyToRight = (scrollLeft + offsetWidth) > (scrollWidth - 1);
        this.scrolledCompletelyToLeft = scrollLeft === 0;
      },

      getTooltipPosition() {
        const hoveredElement = document
          .getElementById(`${this.techniqueHovered.id}_${this.techniqueHovered.parent}_box`)
          ?.getBoundingClientRect();

        if (!hoveredElement) {
          return "";
        }

        const xPosition = window.scrollX + hoveredElement.x;
        const yPosition = window.scrollY + hoveredElement.y;
        return "top:" + yPosition + "px;left:" + (xPosition - 65) + "px;";
      },

      getAttackObjectDict() {
        this.errorMessage = "";

        const attack_object_file =
          `${this.url_prefix}static/matrices/${this.selectedDomain}/${this.selectedAttackVersion}/` +
          `${this.selectedDomain}-${this.selectedAttackVersion}_matrix_data.json`;

        fetch(attack_object_file)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Failed to load matrix data: " + response.status);
            }
            return response.json();
          })
          .then((json) => {
            this.attackObjectDict = json || {};
            this.getTactics();
            this.getDescription();
          })
          .catch((error) => {
            console.error(error);
            this.attackObjectDict = {};
            this.tactics = [];
            this.description = "";
            this.errorMessage = "Unable to load matrix data for this ATT&CK version/domain combination.";
          });
      },

      getDescription() {
        const attack_object_file =
          `${this.url_prefix}data/attack/${this.selectedDomain}-attack-${this.selectedAttackVersion}.json`;

        fetch(attack_object_file)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Failed to load ATT&CK description: " + response.status);
            }
            return response.json();
          })
          .then((json) => {
            const objects = json["objects"] || [];
            const d = Object.values(objects).filter((value) => {
              return value.type === "x-mitre-collection";
            });
            this.description = d.length ? d[0].description : "";
          })
          .catch((error) => {
            console.error(error);
            this.description = "";
          });
      },

      getTactics() {
        if (this.selectedDomain && this.matrix_order) {
          this.matrixOrder = this.matrix_order[this.selectedDomain] || [];
        } else {
          this.matrixOrder = [];
        }

        const tactics = Object.values(this.attackObjectDict || {}).filter((value) => {
          return value && value.type === "tactic";
        });

        let sortedTactics = [];
        this.matrixOrder.forEach((t) => {
          const tactic = tactics.find((candidate) => candidate.id === t);
          if (tactic) {
            sortedTactics.push(tactic);
          }
        });

        sortedTactics = sortedTactics.map((tactic) => {
          tactic.techniques = Object.values(this.attackObjectDict || {}).filter((value) => {
            return (
              value &&
              value.type === "technique" &&
              (value.tactics || []).includes(tactic.short_name)
            );
          });

          tactic.techniques = tactic.techniques.map((technique) => {
            technique.open = false;
            technique.parent = tactic.id;
            technique.subtechniques = Object.values(this.attackObjectDict || {}).filter((value) => {
              return (
                value &&
                value.type === "subtechnique" &&
                value.technique === technique.id
              );
            });

            technique.subtechniques = technique.subtechniques.map((subtechnique) => {
              subtechnique.parent = technique.parent;
              return { ...subtechnique };
            });

            return { ...technique };
          });

          return { ...tactic };
        });

        this.tactics = sortedTactics;
      },

      handleClick(technique) {
        technique.open = !technique.open;
      },

      toggleAllTechniques(open) {
        this.tactics.forEach((tactic) =>
          (tactic.techniques || []).forEach((technique) => {
            technique.open = open;
          })
        );
      },

      setVersionsAccoringToQueryParams() {
        const url = new URL(window.location.href);
        const requestedDomain = url.searchParams.get("domain");
        const requestedVersion = url.searchParams.get("attack-version");

        if (
          requestedDomain &&
          this.attackDomains.includes(requestedDomain.toLowerCase())
        ) {
          this.selectedDomain = requestedDomain.toLowerCase();
        }

        if (requestedVersion) {
          this.selectedAttackVersion = requestedVersion;
        }

        this.normalizeSelection();
        this.syncUrl();
      },

      handleOutsideClick() {
        this.attackSelectOpen = false;
        this.domainSelectOpen = false;
      },

      setMatrixColumnAmount() {
        const el = document.getElementById("matrix-table-scrollable");
        if (!el) return;

        const matrixWidth = el.clientWidth;
        this.amountMatrixColsShown =
          matrixWidth <= 576 ? 3 : matrixWidth <= 768 ? 5 : 12;
      },

      handleWindowResize() {
        this.setMatrixColumnAmount();
      },
    },
    watch: {
      tactics(value) {
        if ((value || []).length > this.amountMatrixColsShown) {
          this.scrolledCompletelyToRight = false;
        } else {
          this.scrolledCompletelyToRight = true;
        }
      },
      amountMatrixColsShown(value) {
        if ((this.tactics || []).length > value) {
          this.scrolledCompletelyToRight = false;
        } else {
          this.scrolledCompletelyToRight = true;
        }
      },
    },
    mounted() {
      window.addEventListener("resize", this.handleWindowResize);
      this.setVersionsAccoringToQueryParams();
      this.getAttackObjectDict();
      this.setMatrixColumnAmount();
    },
    unmounted() {
      window.removeEventListener("resize", this.handleWindowResize);
    },
  };

  Vue.createApp({
    components: {
      Matrix
    }
  }).mount("#matrix-component");
</script>
{% endblock content %}
